go 1.22

use (
	./pkg
	./proto
	./cloud-flow-center
	./cloud-flow-edge
	./cloud-flow-agent
	./services/auth-service
	./services/control-plane
	./services/data-plane
	./services/query-service
	./services/alert-engine
	./services/tenant-service
	./services/topology-engine
	./services/shared
	./services/shared/auth
	./services/shared/resilience
)

replace cloudflow/pkg => ./pkg

replace cloudflow/proto => ./proto

replace cloudflow/services/shared => ./services/shared

replace cloudflow/services/shared/auth => ./services/shared/auth

replace cloudflow/services/shared/resilience => ./services/shared/resilience
