# CloudFlow 环境变量模板
# 复制此文件为 .env 并填入实际值
# cp .env.example .env

# ==================== 安全凭证（必须修改） ====================

# CloudFlow Center API Key
# 生成方法: openssl rand -hex 32
CLOUDFLOW_CENTER_API_KEY=

# JWT 密钥（至少 64 字节）
# 生成方法: openssl rand -base64 64
CLOUDFLOW_JWT_SECRET_KEY=

# ==================== 数据库配置 ====================

# TiDB/MySQL 连接
TIDB_DSN=root:@tcp(127.0.0.1:4000)/cloud_flow?parseTime=true&charset=utf8mb4&collation=utf8mb4_bin

# ClickHouse 连接
CLICKHOUSE_DSN=clickhouse://localhost:9000/cloudflow

# Redis 连接
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=

# ==================== Kafka 配置 ====================

KAFKA_BROKERS=localhost:9092
KAFKA_SASL_USERNAME=
KAFKA_SASL_PASSWORD=

# ==================== 邮件告警配置 ====================

SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=user@example.com
SMTP_PASSWORD=
SMTP_FROM=alerts@example.com
SMTP_TO=admin@example.com

# ==================== Webhook 配置 ====================

WEBHOOK_URL=http://localhost:8080/webhook
WEBHOOK_SECRET=
WEBHOOK_AUTHORIZATION=

# ==================== TLS 配置 ====================

TLS_ENABLED=true
TLS_CA_CERT=
TLS_SERVER_CERT=
TLS_SERVER_KEY=

# ==================== 其他配置 ====================

# 日志级别: debug, info, warn, error
LOG_LEVEL=info

# 数据保留天数
RETENTION_DAYS=7

# 集群配置
CLUSTER_ENABLED=false
ETCD_ENDPOINTS=localhost:2379
NODE_ID=
NODE_ADDR=
