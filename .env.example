# CloudFlow 环境变量模板
# 复制此文件为 .env 并填入实际值
# cp .env.example .env

# ==================== 安全凭证（必须修改） ====================

# CloudFlow Center API Key
# 生成方法: openssl rand -hex 32
CLOUDFLOW_CENTER_API_KEY=your_api_key_here

# JWT 密钥（至少 64 字节）
# 生成方法: openssl rand -base64 64
CLOUDFLOW_JWT_SECRET_KEY=your_jwt_secret_here

# ==================== 数据库配置（纯国产化） ====================

# 达梦数据库连接
DAMENG_DSN=dm://SYSDBA:SYSDBA@localhost:5236/cloudflow

# 人大金仓数据库连接
KINGBASE_DSN=kingbase://system:manager@localhost:54321/cloudflow

# 高斯Redis连接
GAUSS_REDIS_ADDR=localhost:6379
GAUSS_REDIS_PASSWORD=

# ==================== Kafka 配置 ====================

KAFKA_BROKERS=localhost:9092
KAFKA_SASL_USERNAME=
KAFKA_SASL_PASSWORD=

# ==================== 邮件告警配置 ====================

SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=user@example.com
SMTP_PASSWORD=
SMTP_FROM=alerts@example.com
SMTP_TO=admin@example.com

# ==================== Webhook 配置 ====================

WEBHOOK_URL=http://localhost:8080/webhook
WEBHOOK_SECRET=
WEBHOOK_AUTHORIZATION=

# ==================== TLS 配置 ====================

TLS_ENABLED=true
