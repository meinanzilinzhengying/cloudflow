# CloudFlow 环境变量模板
# 复制此文件为 .env 并填入实际值
# cp .env.example .env

# ==================== 安全凭证（必须修改） ====================

# CloudFlow Center API Key
# 生成方法: openssl rand -hex 32
CLOUDFLOW_CENTER_API_KEY=your_api_key_here

# JWT 密钥（至少 64 字节）
# 生成方法: openssl rand -base64 64
CLOUDFLOW_JWT_SECRET_KEY=your_jwt_secret_here

# ==================== 数据库配置 ====================

# TiDB 数据库密码（必须设置，用于 TiDB 容器和应用程序）
# 此密码会同时用于:
# 1. TiDB 容器 (MYSQL_ROOT_PASSWORD)
# 2. 应用程序连接字符串 (TIDB_DSN)
CLOUD_FLOW_DB_PASSWORD=your_strong_password_here

# TiDB/MySQL 连接字符串
# 注意: 密码必须与 CLOUD_FLOW_DB_PASSWORD 一致
TIDB_DSN=root:your_strong_password_here@tcp(127.0.0.1:4000)/cloud_flow?parseTime=true&charset=utf8mb4&collation=utf8mb4_bin

# ClickHouse 连接
CLICKHOUSE_DSN=clickhouse://localhost:9000/cloudflow

# Redis 连接
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=

# ==================== Kafka 配置 ====================

KAFKA_BROKERS=localhost:9092
KAFKA_SASL_USERNAME=
KAFKA_SASL_PASSWORD=

# ==================== 邮件告警配置 ====================

SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=user@example.com
SMTP_PASSWORD=
SMTP_FROM=alerts@example.com
SMTP_TO=admin@example.com

# ==================== Webhook 配置 ====================

WEBHOOK_URL=http://localhost:8080/webhook
WEBHOOK_SECRET=
WEBHOOK_AUTHORIZATION=

# ==================== TLS 配置 ====================

TLS_ENABLED=true
